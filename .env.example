# Google AI Studio で発行した API キー（https://aistudio.google.com/apikey）
# このファイルを .env にコピーしてキーを書く。.env は git に含めない
GEMINI_API_KEY=
# 使うモデル（省略時は gemini-flash-lite-latest: 約2秒。gemini-flash-latest は約7〜10秒だが動きが凝る）
GEMINI_MODEL=gemini-flash-lite-latest
# 推論の深さ minimal / low / medium / high（省略時 low）
GEMINI_THINKING=low
